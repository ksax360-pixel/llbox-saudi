# Server
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/llbox_ai

# JWT
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# LLBox X360 middleware (Phase 2)
LLBOX_BASE_URL=https://llbox.up.railway.app/api/v1
LLBOX_API_KEY=your_llbox_agent_api_key
LLBOX_DUMMY_MODE=true

# Optional shared secret for /api/tools/* (n8n Authorization: Bearer ...)
TOOL_API_KEY=

# WhatsApp (portal admin 2FA)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE_NAME=llb_otp
WHATSAPP_OTP_TEMPLATE_LANG=en

# Twilio (Phase 2)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ElevenLabs (Phase 2)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# External APIs (stored in Settings too)
GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=

    {
      "name": "Conversations",
      "item": [
        {
          "name": "List Conversations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/conversations?page=1&limit=20"
          }
        },
        {
          "name": "Create Conversation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.conversation) {",
                  "  pm.collectionVariables.set('conversationId', res.data.conversation._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"callerNumber\": \"+966500000001\",\n  \"transcript\": \"Driver asked for OTP for ABC123\",\n  \"duration\": 60,\n  \"language\": \"en\",\n  \"intent\": \"resolve_delivery\",\n  \"toolCalls\": [{ \"toolName\": \"resolve-delivery\", \"input\": { \"orderReference\": \"ABC123\" }, \"success\": true }],\n  \"response\": \"OTP is 4589\",\n  \"status\": \"completed\"\n}"
            },
            "url": "{{baseUrl}}/api/conversations"
          }
        },
        {
          "name": "Get Conversation",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/conversations/{{conversationId}}"
          }
        },
        {
          "name": "Delete Conversation",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/conversations/{{conversationId}}"
          }
        },
        {
          "name": "List Call Logs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/conversations/call-logs"
          }
        },
        {
          "name": "Create Call Log",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.callLog) {",
                  "  pm.collectionVariables.set('callLogId', res.data.callLog._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"incomingNumber\": \"+966500000099\",\n  \"twilioCallSid\": \"CA_TEST_099\",\n  \"elevenLabsConversationId\": \"conv_test_099\",\n  \"status\": \"completed\",\n  \"duration\": 45,\n  \"recordingUrl\": \"https://example.com/rec.mp3\",\n  \"direction\": \"inbound\"\n}"
            },
            "url": "{{baseUrl}}/api/conversations/call-logs"
          }
        },
        {
          "name": "Update Call Log",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\",\n  \"duration\": 50,\n  \"notes\": \"Updated from Postman\"\n}"
            },
            "url": "{{baseUrl}}/api/conversations/call-logs/{{callLogId}}"
          }
        }
      ]

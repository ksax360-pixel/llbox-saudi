# Server
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/llbox_ai

# JWT
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# LLBox (Phase 2 – not used in Phase 1 dummy mode)
LLBOX_BASE_URL=https://llbox.up.railway.app/api/v1
LLBOX_API_KEY=your_llbox_agent_api_key
LLBOX_DUMMY_MODE=true

# Twilio (Phase 2)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ElevenLabs (Phase 2)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# External APIs (stored in Settings too)
GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=
